MMWIKI_API_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MMWIKI_API_KEY=
MMWIKI_BUILD_MODEL=qwen3.7-plus
MMWIKI_VISION_MODEL=qwen3-vl-plus
# 增量多模态 Wiki 默认只使用 MinerU Caption + BM25；按需显式打开能力。
MMWIKI_ENABLE_VLM=false
MMWIKI_ENABLE_VECTOR_RETRIEVAL=false
# 检索增强模型。URL 默认根据 MMWIKI_API_BASE_URL 自动推导。
MMWIKI_TEXT_EMBEDDING_MODEL=qwen3.7-text-embedding
MMWIKI_TEXT_RERANK_MODEL=qwen3-rerank
MMWIKI_VL_EMBEDDING_MODEL=qwen3-vl-embedding
MMWIKI_VL_RERANK_MODEL=qwen3-vl-rerank
MMWIKI_EMBEDDING_DIMENSION=1024
MMWIKI_TIMEOUT=60
MMWIKI_MAX_IMAGES=4
MMWIKI_MAX_OUTPUT_TOKENS=3000
# 仅在需要旧版 Obsidian 适配器时显式开启；OpenCode 演示无需开启。
MMWIKI_INSTALL_OBSIDIAN_PLUGIN=false
